{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:notchlore:aperture:assessment:1",
  "title": "Notch Lore Aperture assessment v1",
  "$comment": "Editor schema for the compact record. Runtime validation additionally checks local paths/hashes, identity bindings, reference closure, history, independent type policy and readiness. Numeric/type policy is maintained in skills/notchlore/references/aperture-rules.json.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "plane": {
      "enum": [
        "documentation",
        "implementation"
      ]
    },
    "stage": {
      "enum": [
        "Prototype",
        "MVP",
        "Production"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "candidate": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "allowed",
        "reason",
        "blockers"
      ],
      "additionalProperties": false
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal"
      },
      "minItems": 1
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      },
      "minItems": 12,
      "maxItems": 12
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      },
      "minItems": 0
    },
    "scopeChange": {
      "$ref": "#/$defs/scopeChange"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "plane",
    "stage",
    "scope",
    "candidate",
    "environment",
    "reviewer",
    "reviewedAt",
    "authority",
    "goals",
    "dimensions",
    "findings",
    "evidence",
    "gates"
  ],
  "additionalProperties": false,
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "plane": {
          "enum": [
            "documentation",
            "implementation"
          ]
        },
        "scopeId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "scopeRevision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "candidate": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "plane",
        "scopeId",
        "scopeRevision",
        "candidate",
        "environment"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "revision",
        "description"
      ],
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "goalIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "description",
        "goalIds"
      ],
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "D01",
            "D02",
            "D03",
            "D04",
            "D05",
            "D06",
            "D07",
            "D08",
            "D09",
            "D10",
            "D11",
            "D12"
          ]
        },
        "status": {
          "enum": [
            "ASSESSED",
            "UNKNOWN",
            "N/A"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewedTypes": {
          "type": "array",
          "items": {
            "enum": [
              "DEF",
              "DIS",
              "EXC",
              "UNC"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          },
          "minItems": 0
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "binding": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "id",
        "status",
        "reviewedTypes",
        "criteria",
        "evidenceIds",
        "binding"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ASSESSED"
              }
            }
          },
          "then": {
            "properties": {
              "reviewedTypes": {
                "minItems": 4
              },
              "criteria": {
                "minItems": 1
              },
              "evidenceIds": {
                "minItems": 1
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "N/A"
              }
            }
          },
          "then": {
            "properties": {
              "reviewedTypes": {
                "maxItems": 0
              },
              "evidenceIds": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "dimension": {
          "enum": [
            "D01",
            "D02",
            "D03",
            "D04",
            "D05",
            "D06",
            "D07",
            "D08",
            "D09",
            "D10",
            "D11",
            "D12"
          ]
        },
        "criterion": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "type": {
          "enum": [
            "DEF",
            "DIS",
            "EXC",
            "UNC"
          ]
        },
        "status": {
          "enum": [
            "open",
            "accepted",
            "deferred",
            "resolved",
            "out_of_scope"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "consequence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "correction": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unknown": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "gateIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "closureEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "causeId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "scopeChangeId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "id",
        "dimension",
        "criterion",
        "type",
        "status",
        "description",
        "consequence",
        "correction",
        "owner",
        "evidenceIds",
        "gateIds"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "evidenceIds": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "unknown"
              ]
            }
          ]
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "required": [
              "closureEvidenceIds"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "out_of_scope"
              }
            }
          },
          "then": {
            "required": [
              "scopeChangeId"
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\:\\u0000])[^\\r\\n]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "reuse": {
          "$ref": "#/$defs/reuse"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "binding"
      ],
      "additionalProperties": false
    },
    "reuse": {
      "type": "object",
      "properties": {
        "forBinding": {
          "$ref": "#/$defs/binding"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "forBinding",
        "reason",
        "reviewedBy",
        "reviewedAt"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mandatory": {
          "type": "boolean"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "outcome",
        "mandatory",
        "evidenceIds"
      ],
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "goalIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dimensionIds": {
          "type": "array",
          "items": {
            "enum": [
              "D01",
              "D02",
              "D03",
              "D04",
              "D05",
              "D06",
              "D07",
              "D08",
              "D09",
              "D10",
              "D11",
              "D12"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mandatory": {
          "type": "boolean"
        },
        "applicable": {
          "type": "boolean"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT RUN",
            "INCONCLUSIVE",
            "N/A"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "workload": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "goalIds",
        "dimensionIds",
        "mandatory",
        "applicable",
        "result",
        "method",
        "expected",
        "workload",
        "evidenceIds",
        "binding"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceIds": {
                "minItems": 1
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "applicable": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "const": "N/A"
              },
              "evidenceIds": {
                "minItems": 1
              }
            },
            "required": [
              "reason"
            ]
          },
          "else": {
            "properties": {
              "result": {
                "not": {
                  "const": "N/A"
                }
              }
            }
          }
        }
      ]
    },
    "scopeChange": {
      "type": "object",
      "properties": {
        "previousAssessmentId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "authorizedBy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "before": {
          "type": "object",
          "properties": {
            "scopeRevision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "stage": {
              "enum": [
                "Prototype",
                "MVP",
                "Production"
              ]
            }
          },
          "required": [
            "scopeRevision",
            "stage"
          ],
          "additionalProperties": false
        },
        "after": {
          "type": "object",
          "properties": {
            "scopeRevision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "stage": {
              "enum": [
                "Prototype",
                "MVP",
                "Production"
              ]
            }
          },
          "required": [
            "scopeRevision",
            "stage"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "previousAssessmentId",
        "authorizedBy",
        "rationale",
        "before",
        "after"
      ],
      "additionalProperties": false
    }
  }
}
